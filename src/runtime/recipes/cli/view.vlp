# The CLI app: a command-line on the terminal, and no window, so everything a GUI does
# can be typed or scripted headless. Each node inside cli uses a part as it is (V11).
[manifest]
version = 1

[node "cli"]

[node "cli.command-line"]
recipe = command-line

[node "cli.inspect"]
recipe = inspect

[node "cli.library"]
recipe = library

[node "cli.projects"]
recipe = projects

# open starts the person's editor, or, while the ide runs, gives a file to its editor and
# a folder to its graph.
[node "cli.editor"]
recipe = editor
param  = window=ide:ide.editor.text
param  = graph=ide:ide.graph.graph
