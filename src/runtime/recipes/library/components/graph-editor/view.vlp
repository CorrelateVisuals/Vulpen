# The graph-editor component: the relations part, which finds what links the files the
# graph shows; a bar, which keeps a row along the bottom of the Rect its host gives for a
# button a layer of curves and one each kind of heat, and the rest for the graph part,
# which draws its ground; over it curves, rects and glyphs: its curves first, then its
# boxes over them, then their names; the buttons, as a panel shows its tabs, a list with
# rects and glyphs of its own and a hit, whose press sends the line turning a layer, or
# the heat, on or off; and last, over all of it, a tooltip, which shows the details of
# the curve under the pointer, or what a box costs while the heat shows.
# The host connects a Rect to bar.area, the font's metrics to bar.font, graph.font,
# buttons.font and tip.list.font, the keys part's typed to graph.typed, the theme to the
# graph and the seven drawing parts, and the font and its atlas to the three glyphs; a
# panel shows graph.tabs.
[manifest]
version = 1

[node "graph-editor"]

[node "graph-editor.relations"]
recipe = relations

[node "graph-editor.bar"]
recipe = bar
param  = edge=bottom

[node "graph-editor.graph"]
recipe = graph

[node "graph-editor.curves"]
recipe = curves

[node "graph-editor.rects"]
recipe = rects

[node "graph-editor.glyphs"]
recipe = glyphs

[node "graph-editor.buttons"]
recipe = list
param  = axis=x

[node "graph-editor.button-rects"]
recipe = rects

[node "graph-editor.button-glyphs"]
recipe = glyphs

[node "graph-editor.hit"]
recipe = hit

[node "graph-editor.tip"]
recipe = tooltip

# What links the files shown, and the folder shown in place of the view.
[connection "relations"]
from = graph-editor.relations.relations
to   = graph-editor.graph.relations

[connection "area"]
from = graph-editor.bar.rest
to   = graph-editor.graph.area

[connection "curves"]
from = graph-editor.graph.curves
to   = graph-editor.curves.curves

# The graph's area, its ground, at whose edge the curves are cut, so a curve to a box
# dragged out of view runs to the edge.
[connection "ground"]
from = graph-editor.graph.ground
to   = graph-editor.curves.area

[connection "rects"]
from = graph-editor.graph.rects
to   = graph-editor.rects.rects

[connection "labels"]
from = graph-editor.graph.labels
to   = graph-editor.glyphs.labels

[connection "characters"]
from = graph-editor.graph.characters
to   = graph-editor.glyphs.characters

# A button a layer, lit while it shows.
[connection "layers"]
from = graph-editor.graph.layers
to   = graph-editor.buttons.items
to   = graph-editor.hit.items

[connection "strip"]
from = graph-editor.bar.strip
to   = graph-editor.buttons.place

[connection "button-rects"]
from = graph-editor.buttons.rects
to   = graph-editor.button-rects.rects

[connection "button-labels"]
from = graph-editor.buttons.labels
to   = graph-editor.button-glyphs.labels

[connection "button-characters"]
from = graph-editor.buttons.characters
to   = graph-editor.button-glyphs.characters

# Where each button shows, so a press on one sends its line.
[connection "shown"]
from = graph-editor.buttons.shown
to   = graph-editor.hit.rects

[connection "marks"]
from = graph-editor.buttons.marks
to   = graph-editor.hit.marks

# The details of the curve under the pointer, a row each, and where they show.
[connection "tip"]
from = graph-editor.graph.tip
to   = graph-editor.tip.list.items

[connection "tip-place"]
from = graph-editor.graph.tip-place
to   = graph-editor.tip.list.place
