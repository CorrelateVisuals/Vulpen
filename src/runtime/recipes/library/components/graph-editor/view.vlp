# The graph-editor component: the relations part, which finds what links the files the
# graph shows, the graph part, which draws its ground, and over it curves, rects and
# glyphs: its curves first, then its boxes over them, then their names.
# The host connects a Rect to graph.area, the font's metrics to graph.font and the keys
# part's typed to graph.typed, the theme to the graph and the three drawing parts, and the
# font and its atlas to glyphs; a panel shows graph.tabs.
[manifest]
version = 1

[node "graph-editor"]

[node "graph-editor.relations"]
recipe = relations

[node "graph-editor.graph"]
recipe = graph

[node "graph-editor.curves"]
recipe = curves

[node "graph-editor.rects"]
recipe = rects

[node "graph-editor.glyphs"]
recipe = glyphs

# What links the files shown, and the folder shown in place of the view.
[connection "relations"]
from = graph-editor.relations.relations
to   = graph-editor.graph.relations

[connection "curves"]
from = graph-editor.graph.curves
to   = graph-editor.curves.curves

# The graph's area, its ground, at whose edge the curves are cut, so a curve to a box
# dragged out of view runs to the edge.
[connection "ground"]
from = graph-editor.graph.ground
to   = graph-editor.curves.area

[connection "rects"]
from = graph-editor.graph.rects
to   = graph-editor.rects.rects

[connection "labels"]
from = graph-editor.graph.labels
to   = graph-editor.glyphs.labels

[connection "characters"]
from = graph-editor.graph.characters
to   = graph-editor.glyphs.characters
