#version 460
#extension GL_GOOGLE_include_directive : require
#include "baseclasses/GpuLayout.glsl"

layout(local_size_x = 64) in;

layout(set = 1, binding = 0) uniform Pass {
  float amplitude; // a param
  float phase;     // set by the Wave operator every frame
  Floats values;   // kept between frames and swaps, so values glide rather than jump
} pass;

const float spacing = 0.05; // radians between neighbouring values
const float glide = 0.1;    // share of the way to the target covered each frame

void main() {
  const uint i = gl_GlobalInvocationID.x;
  const float target = pass.amplitude * sin(pass.phase + spacing * float(i));
  pass.values.at[i] = mix(pass.values.at[i], target, glide);
}
