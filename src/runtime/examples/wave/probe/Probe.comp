#version 460
#extension GL_GOOGLE_include_directive : require
#include "baseclasses/GpuLayout.glsl"

layout(local_size_x = 8) in;

layout(set = 1, binding = 0) uniform Pass {
  uint step;         // a param: values between two samples
  FloatsIn values;   // the wave node's, through the connection
  FloatsOut samples; // read back by the Probe operator
} pass;

void main() {
  const uint i = gl_GlobalInvocationID.x;
  pass.samples.at[i] = pass.values.at[i * pass.step];
}
