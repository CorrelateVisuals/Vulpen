# A window with one triangle. C++ turns its corners and tints it every frame; the
# shaders draw what C++ wrote. Run ./run.sh src/examples/triangle/view.vlp, then save
# any file of this view while it runs.

[manifest]
version = 1

# Its folder, triangle/, holds its files. A .vert and a .frag make a draw, and
# vertex_count counts its vertices.
[node "triangle"]
operator     = Triangle
file         = Triangle.cpp
file         = Triangle.frag
file         = Triangle.glsl
file         = Triangle.vert
vertex_count = 3
param        = speed=0.01
