# Headless compute: wave fills a buffer, probe samples it back to the CPU and prints it.
# Run ./run.sh src/examples/wave/view.vlp, then save any file of this view while it runs.

[manifest]
version = 1

[node "wave"]
operator    = Wave
file        = Wave.comp
file        = Wave.cpp
invocations = 1024
param       = amplitude=1.0
param       = speed=0.02

[node "probe"]
operator    = Probe
file        = Probe.comp
file        = Probe.cpp
invocations = 8
param       = step=128
param       = every=60
log         = info

[connection "values"]
from = wave.values
to   = probe.values
