# The fail-loud fixture: nodes that get things wrong on purpose, which the views
# src/tools/tests/fail-loud.py writes put together. As a whole it runs only as far as
# its mistakes let it: draw writes a buffer, which a draw may not.

[manifest]
version = 1

# Fills values with its amount. Its C++ registers the operators the cases name, each
# wrong in its own way.
[node "fill"]
file        = Fill.comp
file        = Fill.cpp
invocations = 64
param       = amount=1

# Writes vec2 pairs, which a reader of floats must refuse.
[node "pairs"]
file        = Pairs.comp
invocations = 64

[node "sum"]
file        = Sum.comp
invocations = 64

[node "draw"]
file         = Draw.frag
file         = Draw.glsl
file         = Draw.vert
vertex_count = 3

# Registers the command fill's Twin registers.
[node "twin"]
operator = Twin
file     = Twin.cpp

# Reads back the frame block, and stops when it differs from what the engine wrote.
[node "frame"]
operator    = Frame
file        = Frame.comp
file        = Frame.cpp
invocations = 6

# Stops unless the input command's events reach it in the frame after they were made.
[node "input"]
operator = Input
file     = Input.cpp

# Hands take the frame it cooks in, through a connection between C++ nodes; its C++
# also registers an operator whose output no other node can name.
[node "give"]
operator = Give
file     = Give.cpp

# Stops unless what give handed it was written that frame; its C++ also registers an
# operator that reads it as another type.
[node "take"]
operator = Take
file     = Take.cpp

# Writes structs its shader sums, and stops when the sums differ from what their
# members make; its C++ also registers one whose struct puts two members elsewhere.
[node "shape"]
operator    = Shapes
file        = Shape.comp
file        = Shape.cpp
invocations = 4

# Fills the shapes shape's shader sums, through a connection, with no shader of its own;
# its C++ also registers operators whose struct puts two members elsewhere, and that give
# no room.
[node "maker"]
operator = Maker
file     = Maker.cpp

# Makes a buffer through the engine by hand.
[node "scratch"]
operator = Scratch
file     = Scratch.cpp

# Fills an image once, and stops when its shader samples other pixels than it filled;
# its C++ also registers operators that fill one through a connection, fill one of
# 16-bit floats, fill one again after image clear, fill one nothing samples, and upload
# the wrong count of pixels.
[node "picture"]
operator    = Picture
file        = Picture.comp
file        = Picture.cpp
invocations = 8
image       = picture=R8_UNORM

# Writes the Rects and Labels of a sign, which the library's rects and glyphs draw.
[node "sign"]
operator = Sign
file     = Sign.cpp

# Draws each pixel's place into an image, which look samples in the same frame.
[node "paint"]
file         = Paint.frag
file         = Paint.vert
vertex_count = 3

# Stops when a pixel of paint's image reads back as another.
[node "look"]
operator    = Look
file        = Look.comp
file        = Look.cpp
invocations = 64

[connection "values"]
from = fill.values
to   = sum.values

[connection "count"]
from = give.count
to   = take.count

[connection "painted"]
from = paint.color
to   = look.painted
