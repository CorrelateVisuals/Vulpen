#version 460
#extension GL_GOOGLE_include_directive : require
#include "baseclasses/GpuLayout.glsl"

layout(local_size_x = 6) in;

layout(buffer_reference, std430) writeonly buffer Seen {
  float at[];
};

layout(set = 1, binding = 0) uniform Pass {
  Seen seen; // the frame block as this pass read it, a value an invocation
} pass;

void main() {
  const uint i = gl_GlobalInvocationID.x;
  const float seen[6] = float[6](float(frame.resolution.x),
                                 float(frame.resolution.y),
                                 frame.cursor.x,
                                 frame.cursor.y,
                                 frame.time,
                                 float(frame.index));
  pass.seen.at[i] = seen[i];
}
