# The terminal component: command-line, rects and glyphs: the command port on screen, as
# the CLI is the command port on stdout. Its host connects the Rect it fills to its
# command-line's area, a palette to its rects and glyphs, and a font to its glyphs and its
# command-line, so one theme and one atlas serve every panel, and the keys part's typed to
# its command-line's, which takes them while it has the focus. Tab prints what may come
# among the rows it shows, as a shell does. Its command-line's tabs name it, and the view
# its lines go to, for a panel's tab strip.
[manifest]
version = 1

[node "terminal"]

[node "terminal.command-line"]
recipe = command-line
param  = on=window
param  = title=terminal

[node "terminal.rects"]
recipe = rects

[node "terminal.glyphs"]
recipe = glyphs

[connection "rects"]
from = terminal.command-line.rects
to   = terminal.rects.rects

[connection "labels"]
from = terminal.command-line.labels
to   = terminal.glyphs.labels

[connection "characters"]
from = terminal.command-line.characters
to   = terminal.glyphs.characters
