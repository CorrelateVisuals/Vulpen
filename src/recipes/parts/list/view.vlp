# The list part: one node whose operator is List; it lays out the Items it is handed in
# the Rect its place gives, stacked or, with axis=x, side by side, for a rects and a glyphs
# node to draw, and hands on where each shows as shown, for hit to find the one pressed.
[manifest]
version = 1

[node "list"]
operator = List
file     = List.cpp
param    = axis=y
